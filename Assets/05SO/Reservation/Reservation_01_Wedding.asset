  deadlineDays: 4
  pickupLine: "\uC608\uC57D\uD588\uB358 \uAF43\uB2E4\uBC1C \uCC3E\uC73C\uB7EC \uC654\uC5B4\uC694!
    \uC900\uBE44\uB418\uC168\uB098\uC694?"
  pickupReadyReply: "\uACE0\uB9C8\uC6CC\uC694! \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694."
  pickupFailReply: "\u2026\uC900\uBE44\uAC00 \uC548 \uB410\uB2E4\uACE0\uC694? \uADF8\uB7FC
