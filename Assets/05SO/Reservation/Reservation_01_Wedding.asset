  title: "\uC18C\uAD6D\uC744 \uC655\uCC3D \uB123\uC740 \uACB0\uD63C\uC2DD \uAF43\uB2E4\uBC1C"
  calendarLabel: "\uACB0\uD63C\uC2DD \uC8FC\uBB38"
  callLine: "\uC5EC\uBCF4\uC138\uC694, \uBB18\uC9C0 \uC55E \uAF43\uC9D1\uC774\uC8E0?
    \uC800 \uB2E4\uC74C \uC8FC\uC5D0 \uACB0\uD63C\uD558\uB294\uB370\uC694, <b>\uC18C\uAD6D
    \uC655\uCC3D \uB123\uC740 \uAF43\uB2E4\uBC1C</b>\uC774 \uD544\uC694\uD574\uC11C\uC694!
    \uD560\uBA38\uB2C8\uAC00 \uC774 \uBB18\uC9C0\uC5D0 \uACC4\uC154\uC11C\u2026 \uAF2D
    \uC5EC\uAE30\uC11C \uD558\uACE0 \uC2F6\uC5C8\uC5B4\uC694."
  deadlineDays: 4
  pickupLine: "\uC548\uB155\uD558\uC138\uC694! \uC804\uD654 \uB4DC\uB838\uB358 \uADF8
    \uC2E0\uBD80\uC608\uC694. \uC624\uB294 \uAE38\uC5D0 \uD560\uBA38\uB2C8\uD55C\uD14C
    \uC778\uC0AC\uB4DC\uB9AC\uACE0 \uC654\uC5B4\uC694. \uC8FC\uBB38\uD55C \uAF43\uB2E4\uBC1C,
    \uB2E4 \uC900\uBE44\uB418\uC168\uC8E0?"
  pickupReadyReply: "\uB2E4\uD589\uC774\uB2E4! \uADF8\uB7FC \uC798 \uBD80\uD0C1\uB4DC\uB824\uC694.
    \uAE30\uB2E4\uB9B4\uAC8C\uC694!"
  pickupFailReply: "\u2026\uB124? \uC624\uB298\uC774 \uACB0\uD63C\uC2DD\uC778\uB370\uC694?
    \uD558\u2026 \uC608\uC57D\uAE08 \uB3CC\uB824\uC8FC\uC138\uC694. \uB2E4\uB978
    \uB370 \uC54C\uC544\uBCFC\uAC8C\uC694."
  bouquetCount: 5
  gradeLineS: "\uC138\uC0C1\uC5D0\u2026 \uD560\uBA38\uB2C8\uAC00 \uBCF4\uC168\uC73C\uBA74
    \uBD84\uBA85 \uC6B0\uC168\uC744 \uAC70\uC608\uC694. \uACE0\uB9C8\uC6CC\uC694,
    \uC815\uB9D0\uB85C!"
  gradeLineA: "\uC608\uBED0\uC694! \uC0DD\uAC01\uD588\uB358 \uAC83\uBCF4\uB2E4 \uD6E8\uC52C\uC694.
    \uC2DD\uC7A5\uC5D0\uC11C \uC790\uB791\uD560\uAC8C\uC694!"
  gradeLineB: "\uB124, \uC8FC\uBB38\uD55C \uB300\uB85C\uB124\uC694. \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  gradeLineC: "\u2026\uC74C. \uC870\uAE08 \uC544\uC27D\uC9C0\uB9CC, \uC2DC\uAC04\uC774
    \uC5C6\uC73C\uB2C8 \uADF8\uB0E5 \uAC00\uC838\uAC08\uAC8C\uC694."
  gradeLineD: "\uC774\uAC78\u2026 \uACB0\uD63C\uC2DD\uC5D0 \uB4E4\uACE0 \uAC00\uB77C\uACE0\uC694?
    \uC8FC\uBB38\uC774\uB791 \uB108\uBB34 \uB2E4\uB974\uC796\uC544\uC694. \uB3C8\uC740
    \uBABB \uB4DC\uB9AC\uACA0\uB124\uC694."
