  id: reservation-craft
  title: "\uC608\uC57D \uAF43\uB2E4\uBC1C \uC81C\uC791"
  icon: {fileID: 21300000, guid: 9a9c1d38a8418c649ad9d1e01fc5923e, type: 3}
  pages:
  - image: {fileID: 21300000, guid: eb3fd33187eadd240b9bff563b898dce, type: 3}
    text: "\uC608\uC57D \uD544\uC218 \uAF43\uACFC \uAC19\uC740 \uC5ED\uD560\uC758
      \uAF43\uC740 \uACE0\uB97C \uC218 \uC5C6\uC5B4\uC694.\n\uAF43\uB2E4\uBC1C \uC81C\uC791\uC744
      \uC2DC\uC791\uD558\uBA74, \uC790\uB3D9\uC73C\uB85C <b>\uD544\uC218 \uAF43</b>\uC774
      \uB2F4\uACA8\uC694."
  - image: {fileID: 21300000, guid: 1e92d3e58bda3c44cb07bfdd0765b84b, type: 3}
    text: "<b>\uD544\uC218 \uC6A9\uD488</b>\uC740 \uC9C1\uC811 \uAF43\uB2E4\uBC1C\uC5D0
      \uBC30\uCE58\uD574\uC57C \uD574\uC694!\n\uD3EC\uD568\uD558\uC9C0 \uC54A\uC73C\uBA74
      \uAC10\uC810\uB418\uB2C8 \uC8FC\uC758\uD558\uC138\uC694."
  - image: {fileID: 21300000, guid: be8605206d0d0b844bcb965d84eda7b5, type: 3}
    text: "\uC81C\uC791\uD574\uC57C \uD558\uB294 \uAF43\uB2E4\uBC1C\uC744 \uBAA8\uB450
      \uB9CC\uB4E4\uAE30 \uC804\uAE4C\uC9C0 \uBC18\uBCF5\uD574\uC694.\n<b>\uC8FC\uBB38\uC11C</b>\uB97C
      \uB204\uB974\uBA74 \uD604\uC7AC \uBA87 \uAC1C\uB97C \uC81C\uC791\uD588\uB294\uC9C0
      \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694!"
