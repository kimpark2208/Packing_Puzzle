  id: reservation-craft
  title: "\uC608\uC57D \uAF43\uB2E4\uBC1C \uC81C\uC791"
  icon: {fileID: 21300000, guid: 9a9c1d38a8418c649ad9d1e01fc5923e, type: 3}
  pages:
  - image: {fileID: 21300000, guid: eb3fd33187eadd240b9bff563b898dce, type: 3}
    text: "\uC608\uC57D \uD544\uC218 \uAF43\uACFC \uAC19\uC740 <b>\uD0DC\uADF8</b>\uB294
      \uACE0\uB97C \uC218 \uC5C6\uC5B4\uC694.\n\uAF43\uB2E4\uBC1C \uC81C\uC791\uC744
      \uC2DC\uC791\uD558\uBA74, \uBCF4\uAD00\uD574\uB454 <b>\uD544\uC218 \uAF43</b>\uC774
      \uC790\uB3D9\uC73C\uB85C \uB4F1\uC7A5\uD574\uC694."
  - image: {fileID: 21300000, guid: 1e92d3e58bda3c44cb07bfdd0765b84b, type: 3}
    text: "<b>\uBE5B\uB098\uB294 \uC6A9\uD488</b>\uC740 \uC608\uC57D \uD544\uC218
      \uC6A9\uD488\uC774\uC5D0\uC694!\n\uD3EC\uD568\uD558\uC9C0 \uC54A\uC73C\uBA74
      \uD06C\uAC8C \uAC10\uC810\uB418\uB2C8 \uC8FC\uC758\uD558\uC138\uC694."
  - image: {fileID: 21300000, guid: ffade725468afa047b90799564cde23f, type: 3}
    text: "<b>\uC8FC\uBB38\uC11C</b>\uB97C \uB204\uB974\uBA74 \uD604\uC7AC \uBA87
      \uAC1C\uB97C \uC81C\uC791\uD588\uB294\uC9C0, \uB204\uC801 \uC810\uC218\uAC00
      \uC5BC\uB9C8\uC778\uC9C0 \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694!"
