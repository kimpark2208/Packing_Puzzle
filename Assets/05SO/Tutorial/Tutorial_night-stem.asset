  id: night-stem
  title: "\uC904\uAE30 \uAEBE\uC784"
  icon: {fileID: 0}
  pages:
  - image: {fileID: 21300000, guid: 846de947b5c0fa44f982c1bfe7022976, type: 3}
    text: "\uAF43\uC758 \uAEBE\uC5EC\uC11C \uB04A\uAE34 \uBD80\uBD84\uC744 \uC774\uC5B4\uC918\uC57C
      \uD574\uC694.\n\uC67C\uCABD \uC218\uCCA9\uC5D0 \uADF8\uB824\uC9C4 \uBE14\uB85D
      \uBAA8\uC591\uB300\uB85C, 1\uBC88 \uC9C0\uC810\uBD80\uD130 2\uBC88 \uC9C0\uC810\uAE4C\uC9C0
      <b>\uB04A\uAE30\uC9C0 \uC54A\uAC8C \uADF8\uB824\uC694!</b>"
  - image: {fileID: 21300000, guid: 93cf426a3cd336c4e993774ace1129dd, type: 3}
    text: "<b>\uAC08\uC0C9 \uCE78</b>\uC740 \uAF43\uC758 \uAC00\uC2DC\uC608\uC694.
      \uAC00\uC2DC \uCE78 \uC704\uC5D0\uB294 \uADF8\uB9B4 \uC218 \uC5C6\uC5B4\uC694."
  - image: {fileID: 21300000, guid: 4adcd3bde4d90b94a999287560b24d8a, type: 3}
    text: "\uBE14\uB85D\uC744 \uB4A4\uC9D1\uAC70\uB098 \uD68C\uC804\uD574\uC11C \uADF8\uB9B0
      \uBAA8\uC591\uC73C\uB85C \uADF8\uB824\uB3C4 \uAD1C\uCC2E\uC544\uC694.\n\uB04A\uAE34
      \uBD80\uBD84\uC744 \uBAA8\uB450 \uC774\uC73C\uBA74 \uCC98\uCE58 \uC644\uB8CC\uC608\uC694."
