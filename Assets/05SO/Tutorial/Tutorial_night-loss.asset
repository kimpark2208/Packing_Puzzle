  id: night-loss
  title: "\uAF43\uC78E \uACB0\uC190"
  icon: {fileID: 0}
  pages:
  - image: {fileID: 21300000, guid: 0ddf9ee1edba6ef41b49be4f1a168614, type: 3}
    text: "\uAF43\uC758 \uACB0\uC190\uB41C \uBD80\uBD84\uC744 \uCC44\uC6CC\uC57C
      \uD574\uC694.\n\uC67C\uCABD \uC218\uCCA9\uC5D0 \uADF8\uB824\uC9C4 \uBE14\uB85D
      \uBAA8\uC591\uB300\uB85C, \uC624\uB978\uCABD \uADF8\uB9AC\uB4DC\uC758 \uACB0\uC190\uB41C
      \uBD80\uBD84\uC5D0 <b>\uADF8\uB824 \uB123\uC5B4\uC694!</b>"
  - image: {fileID: 21300000, guid: 659c58b583cd70242bdcda32fd7cc0d2, type: 3}
    text: "\uBE14\uB85D\uC744 \uB4A4\uC9D1\uAC70\uB098 \uD68C\uC804\uD574\uC11C \uADF8\uB9B0
      \uBAA8\uC591\uC73C\uB85C \uADF8\uB824\uB3C4 \uAD1C\uCC2E\uC544\uC694.\n\uACB0\uC190\uB41C
      \uBD80\uBD84\uC744 \uBAA8\uB450 \uCC44\uC6B0\uBA74 \uCC98\uCE58 \uC644\uB8CC\uC608\uC694."
