  metaphorChance: 0.5
  flowerSpecialOrderChance: 0.1
  fullOrder:
  - "\uCE5C\uAD6C \uC0DD\uC77C\uC774\uC5D0\uC694! [\uAF43\uD15C\uD50C\uB9BF] [\uD3EC\uC7A5\uC9C0\uD15C\uD50C\uB9BF]
    \uC774\uC058\uAC8C \uB9CC\uB4E4\uC5B4\uC8FC\uC138\uC694!"
  - "\uACE0\uBC31\uC744 \uD558\uB824\uACE0\uD574\uC694... [\uAF43\uD15C\uD50C\uB9BF]
    [\uD3EC\uC7A5\uC9C0\uD15C\uD50C\uB9BF]"
  flowerDirect:
  - "[\uAF43\uC774\uB984] \uD55C \uC1A1\uC774\uB294 \uAF2D \uB4E4\uC5B4\uAC00\uC57C
    \uD574\uC694."
  - "[\uAF43\uC774\uB984]\uC774\uB791 [\uAF43\uC774\uB984]\uC774\uC694."
  - "[\uAF43\uC774\uB984]\uC774 \uB4E4\uC5B4\uAC04\uB2E4\uBA74 \uBA4B\uC9C8 \uAC83
    \uAC19\uC544\uC694!"
  colorDirect:
  - "[\uC0C9] \uAF43 [\uAC1C\uC218]\uB294 \uAF2D \uB123\uC5B4\uC8FC\uC138\uC694."
  - "[\uC0C9] \uAF43\uC774 [\uAC1C\uC218] \uC815\uB3C4\uB294 \uB4E4\uC5B4\uAC14\uC73C\uBA74
    \uC88B\uACA0\uC5B4\uC694."
  wrapperDirect:
  - "\uD3EC\uC7A5\uC9C0\uB294\u2026 [\uD3EC\uC7A5\uC9C0]\uB85C \uD560\uAC8C\uC694."
  - "\uD3EC\uC7A5\uC9C0\uB294 [\uD3EC\uC7A5\uC9C0]\uAC00 \uC88B\uACA0\uB124\uC694."
  - "\uADF8\uB9AC\uACE0\u2026 \uD3EC\uC7A5\uC9C0\uB294 \uAC00\uC7A5 \uC88B\uC544\uD558\uB294
    \uC0C9\uC73C\uB85C\u2026 [\uD3EC\uC7A5\uC9C0]\uAC00 \uC88B\uACA0\uC5B4\uC694."
  colorMetaphors:
  - label: "Red (\uBE68\uAC04)"
    phrases:
    - "\uB3D9\uBC31 \uAC19\uC740"
    - "\uB538\uAE30 \uAC19\uC740"
  - label: "Orange (\uC8FC\uD669)"
    phrases:
    - "\uB178\uC744 \uAC19\uC740"
    - "\uADE4\uBE5B"
  - label: "Yellow (\uB178\uB780)"
    phrases:
    - "\uBCD1\uC544\uB9AC \uAC19\uC740"
    - "\uD587\uC0B4 \uAC19\uC740"
  - label: "Blue (\uD30C\uB780)"
    phrases:
    - "\uBC14\uB2E4 \uAC19\uC740"
    - "\uD558\uB298\uBE5B"
  - label: "Purple (\uBCF4\uB77C)"
    phrases:
    - "\uB77C\uBCA4\uB354 \uAC19\uC740"
    - "\uD3EC\uB3C4\uBE5B"
  - label: "Pink (\uBD84\uD64D)"
    phrases:
    - "\uBC9A\uAF43 \uAC19\uC740"
    - "\uBCFC\uD130\uCE58 \uAC19\uC740"
  - label: "White (\uD770)"
    phrases:
    - "\uB208 \uAC19\uC740"
    - "\uAD6C\uB984 \uAC19\uC740"
  wrapperMetaphors:
  - label: "Red (\uBE68\uAC04)"
    sentences:
    - "\uD3EC\uC7A5\uC9C0\uB294\u2026 \uC800 \uC791\uB82C\uD558\uB294 \uB178\uC744\uC744
      \uB2EE\uC740 \uC0C9\uC774 \uC88B\uACA0\uB124\uC694!"
  - label: "Yellow (\uB178\uB780)"
    sentences:
    - "\uC0DB\uBCD1\uC544\uB9AC\uAC19\uC740 \uD3EC\uC7A5\uC9C0\uAC00 \uC88B\uACA0\uB124\uC694!"
  - label: "Green (\uCD08\uB85D)"
    sentences: []
  - label: "Blue (\uD30C\uB780)"
    sentences:
    - "\uD3EC\uC7A5\uC9C0\uB294 \uBC14\uB2E4\uB97C \uB2EE\uC740 \uAC83\uC73C\uB85C\uC694."
    - "\uC544\uC8FC \uC6B0\uC6B8\uD574\uC694... So Bluming... \uC774\uB7F0 \uB9C8\uC74C\uC744
      \uB2F4\uC740 \uD3EC\uC7A5\uC9C0\uB85C \uC8FC\uC138\uC694."
  - label: "Purple (\uBCF4\uB77C)"
    sentences:
    - "\uC544\uC8FC... \uC624\uBB18\uD55C\uC0C9\uC774\uC694 \uAC00\uC7A5 \uC624\uBB18\uD558\uACE0
      \uBBF8\uC774\uC774\uC774\uC2A4\uD130\uB9AC\uD55C\uC0C9..."
  - label: "Pink (\uBD84\uD64D)"
    sentences:
    - "\uD3EC\uC7A5\uC9C0\uB294 \uCCAB\uC0AC\uB791\uAC19\uC740~ \uC0C9\uC774\uC5C8\uC73C\uBA74
      \uC88B\uACA0\uC5B4\uC694."
  - label: "White (\uD770)"
    sentences:
    - "\uD3EC\uC7A5\uC9C0\uB294\u2026 \uC544\uBB34 \uC0C9\uB3C4 \uC5C6\uB2E4\uBA74
      \uC88B\uC744 \uAC83 \uAC19\uC544\uC694."
    - "\uC81C \uACF5\uD5C8\uD55C \uB9C8\uC74C\uAC19\uC740 \uD3EC\uC7A5\uC9C0\uB85C
      \uC8FC\uC138\uC694."
